%description
replacement for i3status, written in pure Rust

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
